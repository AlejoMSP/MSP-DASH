// wifi_config.h.example
//
// Copy this file to "wifi_config.h" (same folder) and fill in your real
// network credentials. wifi_config.h is git-ignored - it will never be
// committed or pushed, so your real WiFi password stays local only.
// Same pattern as esp32-main/wifi_config.h on the WROOM board.

#define WIFI_SSID     "YOUR_SSID_HERE"
#define WIFI_PASSWORD "YOUR_PASSWORD_HERE"
